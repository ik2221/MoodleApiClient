<configuration>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <!-- encoders are assigned the type
             ch.qos.logback.classic.encoder.PatternLayoutEncoder by default -->
        <encoder>
            <pattern>%cyan(%d{HH:mm:ss.SSS}) %gray([%thread]) %highlight(%-5level) %magenta(%logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
        Enable debug logging for HTTP clients.

        NOTE: It is quite verbose, so if you don't need it,
        you can comment these lines out and turn it off.
    -->
<!--    <logger name="io.micronaut.http.client" level="TRACE"/>-->
<!--    <logger name="io.micronaut.http.client.netty" level="TRACE"/>-->
<!--    <logger name="reactor.netty.http.client" level="DEBUG"/>-->

    <root level="info">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
